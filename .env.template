# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs allowed to control the bot
TELEGRAM_ALLOWED_USER_IDS=

# Seconds between monitor-loop ticks (pane capture/diff)
MONITOR_INTERVAL_SECONDS=600

# Path to the session registry file (JSON)
SESSION_REGISTRY_PATH=./sessions.json

# Shared secret the hub sends as a Bearer token to every registered PC's
# agent process, and that each agent checks on every incoming request.
# Required once any session's "host" is an agent URL rather than "local".
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AGENT_SHARED_SECRET=

# Port the local agent process listens on (only used when running
# `python -m agent` on a non-hub PC)
AGENT_PORT=8787
